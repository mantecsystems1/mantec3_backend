# Modelo de configuração. Copie para .env (desenvolvimento) ou configure no orquestrador.
# Nunca versione .env com valores reais. Cada ambiente (dev, homologação, produção) tem banco e segredos próprios.

NODE_ENV=development
PORT=3000

# Banco de dados (obrigatório). Use um banco diferente por ambiente.
MONGO_URI=mongodb://127.0.0.1:27017/mantec_dev

# Segredos (obrigatórios em produção; gere valores longos e aleatórios por ambiente)
AUTH_TOKEN_SECRET=
PORTAL_CLIENTE_SECRET=

# Origens do front permitidas, separadas por vírgula (obrigatório em produção)
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Logs de requisição em JSON (um por linha, com X-Request-Id). false desliga.
REQUEST_LOGS=true

# Limite de tentativas (login etc.): memory (uma réplica) | mongo (várias réplicas compartilham o contador)
RATE_LIMIT_STORE=memory

# Proxy/balanceador à frente da API (ex.: 1 ou true)
TRUST_PROXY=

# Documentação Swagger em /api (em produção, apenas temporariamente e com acesso controlado)
SWAGGER_ENABLED=false

# Recusar campos não previstos nos DTOs (true recomendado após validar os clientes da API)
VALIDATION_FORBID_NON_WHITELISTED=false

# Armazenamento de uploads: local | s3
UPLOAD_STORAGE=local
UPLOAD_S3_CONFIG_FILE=

# Integração fiscal (simulação/homologação)
FISCAL_SIMULATION_ENABLED=false
FISCAL_API_URL=
FISCAL_API_KEY=
FISCAL_API_KEY_FILE=
FISCAL_SIMULATION_EMITTERS_JSON=

# Script de criação do admin (scripts/create-admin.js) — sem valores padrão
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_EMPRESA_ID=
